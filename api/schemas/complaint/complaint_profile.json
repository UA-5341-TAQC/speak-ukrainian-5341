{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "complaint_profile.json",
  "title": "ComplaintProfile",
  "description": "Request body used by POST /api/complaint and PUT /api/complaint/{id}. Matches the OpenAPI component schema `ComplaintProfile`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["clubId", "recipientId", "text", "userId"],
  "properties": {
    "id": {"type": "integer"},
    "text": {"type": "string"},
    "userId": {"type": "integer"},
    "clubId": {"type": "integer"},
    "recipientId": {"type": "integer"},
    "isActive": {"type": "boolean"}
  }
}
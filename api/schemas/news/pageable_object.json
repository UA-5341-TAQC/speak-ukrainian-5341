{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pageable_object.json",
  "title": "PageableObject",
  "description": "Pagination metadata of a paginated response. Matches the OpenAPI component schema `PageableObject`.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "offset": {"type": "integer"},
    "sort": {"$ref": "sort_object.json"},
    "pageNumber": {"type": "integer"},
    "pageSize": {"type": "integer"},
    "paged": {"type": "boolean"},
    "unpaged": {"type": "boolean"}
  }
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "get_user_registration_response.json",
  "title": "GetUserRegistrationResponse",
  "description": "Response body returned by GET /api/challenge-registration/user-applications/{userId}. Each entry is either a user registration (user is set, child is null) or a child registration (child is set, user is null).",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["id", "challenge", "active", "approved"],
    "properties": {
      "id": {"type": "integer"},
      "user": {
        "type": ["object", "null"],
        "properties": {
          "id": {"type": "integer"}
        }
      },
      "child": {
        "type": ["object", "null"],
        "properties": {
          "id": {"type": "integer"}
        }
      },
      "challenge": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"}
        }
      },
      "registrationDate": {"type": "string"},
      "comment": {"type": ["string", "null"]},
      "active": {"type": "boolean"},
      "approved": {"type": "boolean"}
    }
  }
}